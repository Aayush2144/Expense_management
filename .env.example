# ============================================================
# Expense Management Environment Variables
# ============================================================

# Database Configuration (MySQL)
# If using a complete connection URL (e.g. from Railway / Render / TiDB Cloud):
# DATABASE_URL=mysql://root:password@host:3306/expense_manager

# Or specify individual parameters:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=expense_manager

# Set to true if your database does not support SSL (default is false for remote hosts)
DB_SSL_DISABLED=false

# Frontend API URL (Points to the FastAPI backend)
# Local: http://localhost:8000
# Production: https://your-backend.onrender.com
API_URL=http://localhost:8000
